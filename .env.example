# Copy to .env.local and fill in. Everything is optional: on mainnet the defaults
# below (lib/config.ts) already point at the real Chog contracts.

# --- Public (inlined into the browser bundle at build time: rebuild after changing) ---
# "mainnet" (Monad, chain 143) or "testnet" (Monad Testnet, chain 10143)
NEXT_PUBLIC_NETWORK=mainnet
# Optional RPC override (defaults to viem's Monad RPC)
NEXT_PUBLIC_RPC_URL=
# Chog NFT collection (ERC-721); defaults to Chog Genesis on mainnet (token IDs 1-1969;
# any other collection accepts every uint256 token ID)
NEXT_PUBLIC_CHOG_NFT_ADDRESS=
# $CHOG ERC-20; defaults to the mainnet token
NEXT_PUBLIC_CHOG_TOKEN_ADDRESS=
# ERC-6551 account implementation passed to the registry; defaults to the Tokenbound AccountProxy
NEXT_PUBLIC_TBA_IMPLEMENTATION=
# bytes32 salt (defaults to 0x00..00)
NEXT_PUBLIC_TBA_SALT=
# "Buy this Portfolio" link; {contract} and {tokenId} are substituted (defaults to OpenSea)
NEXT_PUBLIC_MARKETPLACE_URL_TEMPLATE=
# AnimrTradeGuard deployment (contracts/): the address contracts/script/DeployAnimrTradeGuard.s.sol prints.
# The value below is the live guard on Monad mainnet (deployed 2026-10-19, buy-only capable, source verified on
# Sourcify and Monadscan; /guard shows its roles live). Unset on mainnet = this same guard (lib/contracts/
# animr-trade-guard.ts); set it to an empty value for paper trading only. With it and OPERATOR_PRIVATE_KEY below, an
# owner whose Chog wallet granted the guard, set its limits and holds $CHOG or WMON can switch the agent to on-chain
# mode (POST /api/agents/[tokenId]/mode).
NEXT_PUBLIC_TRADE_GUARD_ADDRESS=0x92D3d4Af4B3b0F29Ec020e407803e135af61987b
# IPFS gateway for NFT metadata and images, with trailing slash (defaults to https://ipfs.filebase.io/ipfs/)
NEXT_PUBLIC_IPFS_GATEWAY=
# Public origin for absolute share-card (og:image) URLs, e.g. https://animr.example. Optional on Vercel, which
# falls back to the production URL; required on any other host, or cards point at localhost.
NEXT_PUBLIC_SITE_URL=
# Privy login (wallets, email code, Google, X, Discord, embedded wallets): the App ID from dashboard.privy.io →
# your app → Settings → Basic. Public, not a secret. Unset = the plain "Connect wallet" menu (browser wallets only).
# Rebuild after changing. Never put the Privy App *Secret* anywhere in this app.
NEXT_PUBLIC_PRIVY_APP_ID=
# Only if the Privy app uses app clients (Settings → Clients); otherwise leave unset.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# --- Server only ---
# 0G Compute Router API key (sk-…) from https://pc.0g.ai → Dashboard → API Keys (mainnet).
# Promo/USD credits only work in USD Billing mode (Dashboard → Billing). Without a key the
# agent uses its rule-based fallback.
ZG_API_KEY=
# Model from https://router-api.0g.ai/v1/models (default glm-5.3; deepseek-v4-flash is cheaper)
ZG_MODEL=
# Router base URL (default https://router-api.0g.ai/v1)
ZG_BASE_URL=
# How JSON output is enforced: json_object (default) | json_schema | prompt
ZG_JSON_MODE=
# off (default) sends the model's switch that disables slow "thinking"; on leaves it enabled
ZG_THINKING=
# on (default) | off. On, every 0G call asks the Router to check the serving provider's TEE signature
# (verify_tee) and report it as x_0g_trace.tee_verified. The Router reports no verdict for sealed traffic, so
# receipts label providers by type instead (TeeML / TeeTLS, zgProviderInfo) and say "TEE verified" only when
# tee_verified is true. off skips the request (lib/agent/zg-compute.ts).
ZG_VERIFY_TEE=
# Protects the cron endpoints: requests must send "Authorization: Bearer <CRON_SECRET>". Required in production.
#  - vercel.json (Vercel Cron, which sends the header itself) calls GET /api/bell/cron daily at 15:00 UTC (rings the
#    Daily Bell, running every claimed agent's brain once) and at 16:00 UTC (settles yesterday's Bell: settlement
#    waits 10 min past 15:00 for the candles). Vercel Hobby only allows daily crons.
#  - The hourly pulse is external: create two hourly jobs on cron-job.org (or any scheduler), each a GET with the
#    header Authorization: Bearer <CRON_SECRET>, e.g. at minute 5 of every hour:
#      https://<your-site>/api/agent/tick   every awake agent thinks once (runs up to ~60 s)
#      https://<your-site>/api/bell/cron    settles and rings whatever is due (backs up a missed or late Vercel run)
#    Give the jobs the longest request timeout the scheduler allows. Both are safe to overlap and repeat: the Bell
#    takes a lock (a busy run answers 409) and every agent run holds its own lock. A Bell route visit also catches
#    up anything due, so a skipped pulse is never fatal.
CRON_SECRET=
# AI operator (only for on-chain mode): the hot key that sends AnimrTradeGuard.trade() for every on-chain agent.
# It can only swap CHOG <-> WMON inside a Chog's own wallet, within the owner's limits; it can never withdraw.
#  - Use a FRESH wallet that only ever holds MON for gas (Monad charges the full gas limit: ~0.5-0.8M per trade).
#  - Never the guard's deployer/admin (the deploy script refuses it) and never an NFT owner's wallet.
#  - Deploy the guard with OPERATOR_ADDRESS = this key's address: guard.operator() must match it.
#  - Never grant it Tokenbound permissions on a Chog wallet: the engine refuses to trade a vault it can reach directly.
# Server only: never prefix it with NEXT_PUBLIC_; the app never logs it. Rotate with guard.setOperator() if leaked.
OPERATOR_PRIVATE_KEY=
# The operator's public address. Read by the guard deploy script (contracts/script/DeployAnimrTradeGuard.s.sol) and
# by "Rob this Chog", whose proof simulates the House wallet's transfer from it (only the address: the heist never
# signs). A deployed guard's own operator() wins over it. Live: 0x2523bBdD941783C4E565180D2a1b18DE86319cC2.
OPERATOR_ADDRESS=

# --- For the scripts only, never the app (keep these out of Vercel) ---
# The House hot key: deployed the guard, grew the pool's oracle (contracts/script/GrowPoolOracle.s.sol) and pays the
# Oracle Purses (scripts/send-oracle-purse.mts). Small balances only: MON for gas plus the purses' $CHOG. The app
# never reads it; the purse script prints only its address. Live: 0xbcfD3a3846e39a687901EB77ed05F4E3CdC1e259.
HOUSE_PRIVATE_KEY=
# HOUSE_PRIVATE_KEY's address: scripts check it matches, and a dry run of the purse script needs only this.
HOUSE_ADDRESS=
# The guard's admin after deployment (a cold key or Safe, never the operator): the deploy script starts a two-step
# transfer to it, and that wallet calls acceptAdmin() (the "Accept admin" button on /guard shows only to it). The
# admin can pause trading and rotate the operator, nothing else.
ADMIN_ADDRESS=

# --- Daily Bell: the Oracle Purse ---
# $CHOG the team sends into each settled live Bell's Oracle of the Day's own ERC-6551 wallet (whole tokens; unset or 0 =
# no purse, and the Bell promises none). Set it only to an amount the team will really send after every Bell, from a
# funded House key. scripts/send-oracle-purse.mts sends it (dry run unless --broadcast) and records it; the Bell API
# shows the amount and the transfer, "on its way" for up to 48 h after settlement while none is recorded, then "not sent".
# Run the script with ANIMR_ENV and the Redis credentials of the deployment whose Bells it pays (production on
# Vercel): ANIMR_ENV=production JITI_TSCONFIG_PATHS=1 npx jiti scripts/send-oracle-purse.mts [--broadcast]
ORACLE_PURSE_CHOG=

# --- Rob this Chog (the House Chog heist) ---
# Token id of the House Chog, whose own wallet holds the heist's real $CHOG (and never wins its own Oracle Purse).
# Unset = the House Chog is "moving in": /heist and /guard say so until it is set.
HOUSE_CHOG_TOKEN_ID=
# 0G spend per UTC day for the House Chog's replies, in USD (default 3; 0 = template replies only). When it is
# spent, the Chog naps until 00:00 UTC.
HEIST_DAILY_USD_CAP=
# Bearer token for the Hall of Fame admin: approving LLM-written replies (they stay held until then) and removing
# entries. Unset = no admin, and LLM-written replies stay held.
HEIST_ADMIN_SECRET=
# Secret key for hashing visitors' IPs in the heist's rate limits (default: derived from CRON_SECRET).
HEIST_IP_SALT=

# --- Storage and other server settings ---
# Persistence (Upstash Redis, or Vercel KV's KV_REST_API_* pair). Required on Vercel:
# without it, state goes to .data/ locally (animr.json plus one file per key in kv/) and to per-instance /tmp on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Namespace inside that Redis, so several deployments can share one database: keys are stored as
# "animr:<namespace>:...". Defaults to VERCEL_ENV (production / preview / development), else "dev", so a
# laptop's `next dev` with the production credentials never touches production data. Set it to
# "production" on any host other than Vercel.
ANIMR_ENV=
# Local file store directory (defaults to .data/, or /tmp/animr on Vercel); point it at an empty folder for a clean run
ANIMR_DATA_DIR=
# Daily cap on "Think now" runs across all agents (each is one paid 0G call, exact cost on its receipt; default 400)
ANIMR_MANUAL_RUNS_PER_DAY=

# Farcaster Mini App account association (submission/FARCASTER.md): from Warpcast's Manifest Tool after deploy.
FARCASTER_HEADER=
FARCASTER_PAYLOAD=
FARCASTER_SIGNATURE=

# OpenSea listings for /market (optional): a permanent key from https://opensea.io/settings/developer.
# Without it the app requests a free, short-lived agent key on first use.
OPENSEA_API_KEY=

# "Ask this Chog" (optional): global cap on 0G calls per UTC day (default 1500; 0 = template answers only).
CHOG_CHAT_DAILY_CALLS=

# AnimrTrophies (soulbound ERC-1155 minted into Chog wallets). Unset = no cabinet, no awards.
NEXT_PUBLIC_TROPHIES_ADDRESS=
